PORT=3001
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:SUBSTITUA@SEU_HOST:5432/postgres
# Em produção, use a conexão TLS fornecida pelo Supabase.
DB_SSL=true
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUBSTITUA
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA
# Leitura local por padrão; não usa a API. Consulte o README.md.
PDF_READER=local
# Caminhos opcionais quando os executáveis não estão no PATH:
# PDFINFO_PATH="C:/ferramentas/poppler/Library/bin/pdfinfo.exe"
# PDFTOTEXT_PATH="C:/ferramentas/poppler/Library/bin/pdftotext.exe"
# PDFTOPPM_PATH="C:/ferramentas/poppler/Library/bin/pdftoppm.exe"
# TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
# IA somente se escolher explicitamente PDF_READER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUBSTITUA
